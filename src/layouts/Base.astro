---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = "Devene.io — AI-Powered Software Development Agency | Software with Soul",
  description = "Devene.io is an AI-powered software development agency. Product strategy, AI strategy, custom software, BI & data, and automation — delivered by senior humans, accelerated by AI. First working demo in 7 days.",
  current = '',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Devene.io">
<meta name="robots" content="index, follow">
<link rel="canonical" href={new URL(Astro.url.pathname, 'https://devene.io/').toString()}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Devene.io">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={new URL(Astro.url.pathname, 'https://devene.io/').toString()}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&family=Space+Grotesk:wght@300..700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
  <Nav current={current} />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
